# ============================================================
# 2MC Gastro — environment variables (example)
# Copy to .env and fill in. Never commit .env to git.
# ============================================================

# --- Supabase ------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Stripe (client) ----------------------------------------
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# --- PostHog (client, analytics) ----------------------------
VITE_POSTHOG_KEY=phc_your_posthog_project_key
VITE_POSTHOG_HOST=https://eu.posthog.com

# --- Meilisearch (client, search-only key) ------------------
VITE_MEILI_HOST=https://search.2mcgastro.com
VITE_MEILI_SEARCH_KEY=your-search-only-key

# --- App ----------------------------------------------------
APP_URL=http://localhost:5173

# --- Brand assets / image proxy (client) --------------------
# Defaults derive from VITE_SUPABASE_URL; override only if the image-proxy
# function or the public "2mcwerbung" logo bucket live on a different project.
#   VITE_IMAGE_PROXY_URL  → defaults to ${VITE_SUPABASE_URL}/functions/v1/image-proxy
#   VITE_BRAND_ASSETS_URL → defaults to ${VITE_SUPABASE_URL}/storage/v1/object/public/2mcwerbung
# VITE_IMAGE_PROXY_URL=
# VITE_BRAND_ASSETS_URL=

# ============================================================
# Server-side only — set these as Supabase edge function
# secrets with `supabase secrets set KEY=value` or via dashboard.
# DO NOT prefix with VITE_ — they must never be exposed.
# ============================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=2MC Gastro <noreply@2mcgastro.com>

# Meilisearch (admin key — sync only)
MEILI_HOST=https://search.2mcgastro.com
MEILI_ADMIN_KEY=your-admin-key

# Anthropic Claude (AI chat)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Apify (Müşteri Bulma — Google Maps scraper, server-side only)
# apify-google-maps edge function bu token ile compass~crawler-google-places
# aktörünü çağırır. ASLA VITE_ ile expose etme.
APIFY_API_TOKEN=apify_api_your_token

# Legacy — Meshy AI (3D generation, already used)
MESHY_API_KEY=your-meshy-key

# Legacy — Gemini (optional)
GEMINI_API_KEY=your-gemini-key

# ============================================================
# External Public API (api-gateway + api-keys-admin)
# ------------------------------------------------------------
# No NEW secrets required — both functions reuse SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY (already configured for the other functions).
#
# Deploy:
#   supabase functions deploy api-keys-admin
#   supabase functions deploy api-gateway --no-verify-jwt   # external callers use OUR api keys
#
# The frontend docs page (developers/api) builds the OpenAPI URL from
# VITE_SUPABASE_URL above; no extra client env var is needed.
#
# image-proxy (cross-origin image fetch for PDF/canvas):
#   supabase functions deploy image-proxy --no-verify-jwt
# Optional SSRF allowlist (comma-separated host suffixes; empty = any public https host):
# IMAGE_PROXY_ALLOWED_HOSTS=supabase.co,2mc-gastro.de
# ============================================================
