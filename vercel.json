{
  "functions": {
    "api/sync-diamond.ts": {
      "maxDuration": 300
    },
    "api/sync-combisteel.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap-products.xml", "destination": "/api/sitemap-products" },
    { "source": "/feed-gmc.xml", "destination": "/api/feed-gmc" },
    { "source": "/rss.xml", "destination": "/api/rss" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-diamond",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync-combisteel",
      "schedule": "0 6 * * *"
    }
  ]
}
