# -----------------------------------------------------------------------------
# 2MC Gastro — Deploy otomasyonu için ortam değişkenleri
# -----------------------------------------------------------------------------
# Bu dosyayı ".env.deploy" olarak kopyala ve kendi bilgilerini doldur.
# .env.deploy zaten .gitignore içinde; asla commit edilmez.
# -----------------------------------------------------------------------------

# --- ZORUNLU: Vercel Deploy Hook URL ---
# Vercel Dashboard → 2mc-gastro projesi → Settings → Git → Deploy Hooks
#   Hook Name: "prod-deploy"   Branch: main   → CREATE HOOK
# Verilen URL'yi aşağıya yapıştır:
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_XXXXX/YYYYY

# --- OPSİYONEL: GitHub repository_dispatch (scripts/deploy.sh --github için) ---
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
#   Repository access: sadece 2mc-gastro   Permissions: Actions: Read & write
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_REPO=cevikademm/2mc-gastro

# --- OPSİYONEL: Lokal vercel CLI için (vercel build/deploy çalıştırırsan) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=team_n41lqYU6oRB9bwmiOJqQVWeS
# VERCEL_PROJECT_ID=prj_hswMS3mIw5VZPJedp9azWbgBRXBm
